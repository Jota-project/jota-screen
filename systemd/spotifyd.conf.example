# Plantilla de spotifyd para jota-screen. scripts/install.sh la rellena en
# ~/.config/jota-screen/spotifyd.conf si no tienes ya ~/.config/spotifyd/spotifyd.conf.
# El nombre del altavoz no va aquí: scripts/spotifyd-run.sh lo pasa con --device-name
# (TV_SPOTIFY_DEVICE o TV_NAME), para que coincida con el que busca el servidor.
[global]
backend = "pulseaudio"
device_type = "t_v"
bitrate = 320
volume_controller = "softvol"
# con la tele por ADB (TV_ADB) el volumen lo lleva la tele: spotifyd siempre al máximo
initial_volume = 100
volume_normalisation = true
use_mpris = true
cache_path = "@HOME@/.cache/spotifyd"
max_cache_size = 2000000000
