[Unit]
Description=TV kiosk (Xorg + Chrome)
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
User=sito
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/bin/xinit /home/sito/tv/kiosk-session.sh -- :0 vt1 -keeptty -nolisten tcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
