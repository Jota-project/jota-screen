{
  // Mando del móvil (public/mando): módulos ES de navegador, sin build. Solo comprobación de tipos.
  // Va aquí y no en public/mando porque el servidor estático publica todo lo que hay en public/.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": [],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": ["public/mando/**/*.js"],
  // theme.js es un script clásico minificado (se carga antes de pintar), no un módulo
  "exclude": ["public/mando/theme.js"]
}
