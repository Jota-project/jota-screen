# Lo que ya sigue el código (https://editorconfig.org): UTF-8, LF, 2 espacios y salto de línea final.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
# dos espacios al final de línea son un salto en Markdown
trim_trailing_whitespace = false
